@startuml
actor User
participant "Frontend" as FE
participant "Backend" as BE
participant "Google OAuth" as GO

User -> FE: Click "Sign in with Google"
FE -> GO: Redirect to Google OAuth
User -> GO: Authenticate and grant permissions
GO -> FE: Redirect with authorization code
FE -> BE: Send authorization code
BE -> GO: Exchange code for tokens
GO -> BE: Return access and refresh tokens
BE -> BE: Verify token and create user session
BE -> FE: Send session token
FE -> FE: Store session token
FE -> User: Show authenticated state
@enduml
